# Copy to .env.local for local development. Never commit real values.

# Public base URL of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Forms (P3) — Resend
RESEND_API_KEY=
FORM_TO_EMAIL=            # coop inbox for submissions
FORM_FROM_EMAIL=          # verified sender, e.g. no-reply@<domain>
FORM_WEBHOOK_URL=         # optional: forward JSON to GoHighLevel/n8n

# Spam protection (P3) — Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# CMS (P5) — Keystatic GitHub mode
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
